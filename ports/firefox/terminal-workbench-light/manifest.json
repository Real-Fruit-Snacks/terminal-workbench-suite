{
  "manifest_version": 2,
  "name": "Terminal Workbench Light",
  "description": "Calm graphite terminal-workbench chrome for Firefox — light mode.",
  "author": "Real-Fruit-Snacks",
  "version": "1.2.0",
  "applications": {
    "gecko": {
      "id": "terminal-workbench-light@real-fruit-snacks"
    }
  },
  "theme": {
    "colors": {
      "frame": "#f5f7f4",
      "frame_inactive": "#f5f7f4",
      "toolbar": "#edf2ee",
      "tab_selected": "#edf2ee",
      "tab_background_text": "#60706a",
      "tab_text": "#007a4d",
      "tab_line": "#007a4d",
      "toolbar_text": "#007a4d",
      "toolbar_field": "#e2eae5",
      "toolbar_field_text": "#17201d",
      "toolbar_field_border": "#bfcbc5",
      "toolbar_field_focus": "#d6e1db",
      "toolbar_top_separator": "#bfcbc5",
      "toolbar_bottom_separator": "#bfcbc5",
      "bookmark_text": "#007a4d",
      "icons": "#60706a",
      "icons_attention": "#007a4d",
      "button_background_hover": "#d6e1db",
      "button_background_active": "#c8d5cf",
      "popup": "#edf2ee",
      "popup_text": "#17201d",
      "popup_border": "#bfcbc5",
      "popup_highlight": "#c5ded3",
      "popup_highlight_text": "#17201d",
      "sidebar": "#edf2ee",
      "sidebar_text": "#17201d",
      "sidebar_border": "#bfcbc5",
      "sidebar_highlight": "#c5ded3",
      "sidebar_highlight_text": "#17201d",
      "ntp_background": "#f5f7f4",
      "ntp_text": "#17201d"
    }
  }
}
