# Terminal Workbench — dark
# https://github.com/Real-Fruit-Snacks/terminal-workbench-suite

set -g status-style "bg=#0e1214,fg=#879994"
set -g window-status-style "bg=#0e1214,fg=#879994"
set -g window-status-current-style "bg=#182024,fg=#63f2ab"
set -g pane-border-style "fg=#2a363d"
set -g pane-active-border-style "fg=#63f2ab"
set -g message-style "bg=#13191c,fg=#f0c674"
set -g mode-style "bg=#1b3a2d,fg=#dce4df"
set -g copy-mode-match-style "bg=#264a56,fg=#dce4df"
set -g clock-mode-colour "#63f2ab"
