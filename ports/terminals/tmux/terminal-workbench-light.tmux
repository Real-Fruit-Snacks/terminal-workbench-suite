# Terminal Workbench — light
# https://github.com/Real-Fruit-Snacks/terminal-workbench-suite

set -g status-style "bg=#edf2ee,fg=#60706a"
set -g window-status-style "bg=#edf2ee,fg=#60706a"
set -g window-status-current-style "bg=#d6e1db,fg=#007a4d"
set -g pane-border-style "fg=#bfcbc5"
set -g pane-active-border-style "fg=#007a4d"
set -g message-style "bg=#e2eae5,fg=#a46600"
set -g mode-style "bg=#cbe2d8,fg=#17201d"
set -g copy-mode-match-style "bg=#acceda,fg=#17201d"
set -g clock-mode-colour "#007a4d"
